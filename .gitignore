# Ignore node_modules
**/node_modules/

# Ignore .git in subdirectories (they are separate repos)
**/.git/
# 临时移开的嵌套仓库元数据（推送子仓库内容时使用，推完恢复）
**/.git.__hold/

# Ignore temporary files
*.log
*.tmp
*.cache

# Ignore OS files
.DS_Store
Thumbs.db

# 生成的基准夹具（27 MB，可用 GSTACK_BENCH_ENSEMBLE=1 bun test browse/test/security-bench-ensemble-live.test.ts 重新生成）
gstack/browse/test/fixtures/security-bench-haiku-responses.json

